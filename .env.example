# ==============================================================================
# Vidya: Document Intelligence & Grounded Q&A Assistant
# Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and populate your credentials:
# cp .env.example .env (or copy on Windows)
#
# DO NOT commit '.env' to git!
# ==============================================================================

# Required: OpenAI API Key for embeddings (text-embedding-3-small) and LLM (gpt-4o-mini)
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Default LLM Model (Defaults to gpt-4o-mini)
OPENAI_MODEL_NAME=gpt-4o-mini

# Optional: Default Embedding Model (Defaults to text-embedding-3-small)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional: Vector Store Persistence Path
CHROMA_PERSIST_DIRECTORY=./data/chroma_db
